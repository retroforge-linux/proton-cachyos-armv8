diff --git a/dxvk.conf b/dxvk.conf
index c1592ad8..1f0e3186 100644
--- a/dxvk.conf
+++ b/dxvk.conf
@@ -288,6 +288,17 @@
 # d3d11.disableMsaa = False
 
 
+# Creates typeless RGBA8 and RGB10A2 textures with only their UNORM (and
+# sRGB) view formats, so that drivers such as Turnip on the Adreno 6xx can
+# keep them compressed. A texture that gets a view in another format of its
+# family before its first use is rebuilt with the whole family; one that
+# gets it later keeps the narrowed list, and a warning is logged.
+#
+# Supported values: True, False
+
+# d3d11.narrowTypelessFormats = True
+
+
 # Zero-initialize workgroup (TGSM) memory in compute shaders. Some games
 # don't do this and rely on undefined behaviour. Enabling may reduce
 # performance.
