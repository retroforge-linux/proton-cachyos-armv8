+      return m_image;
+    }
+
+    /**
+     * \brief Counts a context's use of one of the texture's views
+     */
+    void NotifyUse() const {
+      if (unlikely(m_narrowState.load(std::memory_order_acquire) == NarrowUnused))
+        MarkUsed();
+    }
+
+    /**
+     * \brief Creates a view's image view on the current image
+     *
+     * Rebuilds a narrowed, still unused texture with its full format list
+     * first when the view's format is not in the narrowed list. Keeps the
+     * view so that a later rebuild can move it to the new image.
+     * \param [in] pView The view
+     * \param [in] Format The view's format
+     */
+    void AttachView(
+            D3D11ImageViewOwner*  pView,
+            VkFormat              Format);
+
+    /**
+     * \brief Forgets a view passed to AttachView
+     * \param [in] pView The view
+     */
+    void DetachView(
+            D3D11ImageViewOwner*  pView);
     
     /**
      * \brief Mapped subresource buffer
@@ -394,7 +447,37 @@ namespace dxvk {
     
     Rc<DxvkImage>                 m_image;
     std::vector<MappedBuffer>     m_buffers;
+
     std::vector<MappedInfo>       m_mapInfo;
+
+    enum NarrowState : uint32_t {
+      NarrowNone    = 0,  ///< Full format list
+      NarrowUnused  = 1,  ///< Narrowed, nothing has used it yet
+      NarrowUsed    = 2,  ///< Narrowed and used: no rebuild any more
+      NarrowWidened = 3,  ///< Rebuilt with the full format list
+    };
+
+    mutable std::atomic<uint32_t>     m_narrowState = { NarrowNone };
+    mutable dxvk::mutex               m_narrowMutex;
+    DxvkImageCreateInfo               m_imageInfo;
+    VkMemoryPropertyFlags             m_memoryProperties = 0;
+    DXGI_VK_FORMAT_FAMILY             m_viewFamily;
+    DXGI_VK_FORMAT_FAMILY             m_fullFamily;
+    std::vector<D3D11ImageViewOwner*> m_views;
+    bool                              m_warnedUsedView = false;
+
+    void MarkUsed() const;
+
+    bool CanNarrowFormats(
+      const DxvkImageCreateInfo&  ImageInfo,
+            BOOL                  IsMultiPlane) const;
+
+    bool WidenLocked(
+            VkFormat              Format);
+
+    static bool FamilyHas(
+      const DXGI_VK_FORMAT_FAMILY& Family,
+            VkFormat              Format);
     
     MappedBuffer CreateMappedBuffer(
             UINT                  MipLevel) const;
