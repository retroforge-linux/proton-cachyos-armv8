    * \brief D3D11 common texture object
    * 
@@ -187,8 +199,49 @@ namespace dxvk {
      * \returns The DXVK image
      */
     Rc<DxvkImage> GetImage() const {
+      // A narrowed texture is rebuilt only while nothing has used it
+      if (unlikely(m_narrowState.load(std::memory_order_acquire) == NarrowUnused))
+        MarkUsed();
       return m_image;
     }
+
+    /**
+     * \brief The DXVK image, without counting as a use
+     *
+     * For the texture's own initialization and its views' creation.
+     * \returns The DXVK image
+     */
