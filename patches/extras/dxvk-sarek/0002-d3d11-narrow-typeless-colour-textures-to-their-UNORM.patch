 src/d3d11/d3d11_device.h        |   4 +
 src/d3d11/d3d11_initializer.cpp |  29 +++++-
 src/d3d11/d3d11_initializer.h   |   4 +
 src/d3d11/d3d11_options.cpp     |   1 +
