--- a/src/d3d11/d3d11_device.h
+++ b/src/d3d11/d3d11_device.h
@@ -413,6 +413,10 @@ namespace dxvk {
       return DxvkCsChunkRef(chunk, &m_csChunkPool);
     }
     
+    void InitRebuiltTexture(D3D11CommonTexture* pTexture, const Rc<DxvkImage>& OldImage) {
+      m_initializer->InitRebuiltTexture(pTexture, OldImage);
+    }
+
     const D3D11Options* GetOptions() const {
       return &m_d3d11Options;
     }
diff --git a/src/d3d11/d3d11_initializer.cpp b/src/d3d11/d3d11_initializer.cpp
