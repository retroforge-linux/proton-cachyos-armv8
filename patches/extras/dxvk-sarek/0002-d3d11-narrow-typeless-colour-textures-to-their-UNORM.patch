+  void D3D11Initializer::InitRebuiltTexture(
+          D3D11CommonTexture*         pTexture,
+    const Rc<DxvkImage>&              OldImage) {
+    std::lock_guard<dxvk::mutex> lock(m_mutex);
+
+    // The new image takes the old one's contents (its initial data or its
+    // zero clear, recorded before this), with every subresource in full
+    Rc<DxvkImage> image = pTexture->PeekImage();
+    const DxvkImageCreateInfo& info = image->info();
+    auto formatInfo = imageFormatInfo(info.format);
+
+    for (uint32_t level = 0; level < info.mipLevels; level++) {
+      VkImageSubresourceLayers layers = { formatInfo->aspectMask, level, 0, info.numLayers };
+
+      m_context->copyImage(
+        image,    layers, VkOffset3D { 0, 0, 0 },
+        OldImage, layers, VkOffset3D { 0, 0, 0 },
+        image->mipLevelExtent(level));
+    }
+
+    m_transferCommands += info.mipLevels;
+    FlushImplicit();
+  }
+
