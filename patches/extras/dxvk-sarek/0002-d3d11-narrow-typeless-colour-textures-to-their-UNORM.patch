index ac0b3725..20cd417c 100644
--- a/src/d3d11/d3d11_options.h
+++ b/src/d3d11/d3d11_options.h
@@ -107,6 +107,12 @@ namespace dxvk {
     /// performs the required shader and resolve fixups.
     bool disableMsaa;
 
+    /// Create typeless colour textures with only the view formats that share
+    /// their base format's encoding (UNORM and sRGB), so that drivers can keep
+    /// them compressed. A view in another format of the family rebuilds the
+    /// texture with the full list while the texture is still unused.
+    bool narrowTypelessFormats;
+
     /// Dynamic resources with the given bind flags will be allocated
     /// in cached system memory. Enabled automatically when recording
     /// an api trace.
diff --git a/src/d3d11/d3d11_texture.cpp b/src/d3d11/d3d11_texture.cpp
index 428cea8c..792895f1 100644
--- a/src/d3d11/d3d11_texture.cpp
+++ b/src/d3d11/d3d11_texture.cpp
@@ -200,6 +200,29 @@ namespace dxvk {
     imageInfo.usage |= EnableMetaPackUsage(imageInfo.format, m_desc.CPUAccessFlags);
     imageInfo.usage |= EnableMetaCopyUsage(imageInfo.format, imageInfo.tiling);
 
+    // Keep only the formats that share the base format's encoding, so that
+    // the driver can compress the image (d3d11.narrowTypelessFormats)
+    if (imageInfo.viewFormatCount > 1 && vkImage == VK_NULL_HANDLE
+     && CanNarrowFormats(imageInfo, isMultiPlane)) {
+      VkFormat srgb = VK_FORMAT_UNDEFINED;
+
+      if (imageInfo.format == VK_FORMAT_R8G8B8A8_UNORM)
+        srgb = VK_FORMAT_R8G8B8A8_SRGB;
+
+      for (uint32_t i = 0; i < imageInfo.viewFormatCount; i++) {
+        m_fullFamily.Add(imageInfo.viewFormats[i]);
+
+        if (imageInfo.viewFormats[i] == imageInfo.format || imageInfo.viewFormats[i] == srgb)
+          m_viewFamily.Add(imageInfo.viewFormats[i]);
+      }
+
+      if (m_viewFamily.FormatCount < m_fullFamily.FormatCount) {
+        imageInfo.viewFormatCount = m_viewFamily.FormatCount;
+        imageInfo.viewFormats     = m_viewFamily.Formats;
+        m_narrowState.store(NarrowUnused, std::memory_order_relaxed);
+      }
+    }
+
     for (uint32_t i = 0; i < imageInfo.viewFormatCount; i++)
       imageInfo.usage |= EnableMetaCopyUsage(imageInfo.viewFormats[i], imageInfo.tiling);
 
@@ -230,11 +253,143 @@ namespace dxvk {
     else
       m_image = m_device->GetDXVKDevice()->createImageFromVkImage(imageInfo, vkImage);
 
+    if (m_narrowState.load(std::memory_order_relaxed) == NarrowUnused) {
+      m_imageInfo = imageInfo;
+      m_memoryProperties = memoryProperties;
+    }
+
     if (imageInfo.sharing.mode == DxvkSharedHandleMode::Export)
       ExportImageInfo();
   }
 
 
+  bool D3D11CommonTexture::CanNarrowFormats(
+    const DxvkImageCreateInfo&  ImageInfo,
+          BOOL                  IsMultiPlane) const {
+    if (!m_device->GetOptions()->narrowTypelessFormats)
+      return false;
+
+    // Only textures that nothing outside D3D11's views and copies can see
+    if (m_mapMode != D3D11_COMMON_TEXTURE_MAP_MODE_NONE
+     || ImageInfo.shared || ImageInfo.sharing.mode != DxvkSharedHandleMode::None
+     || IsMultiPlane || ImageInfo.tiling != VK_IMAGE_TILING_OPTIMAL
+     || (m_dxgiUsage & DXGI_USAGE_BACK_BUFFER))
+      return false;
+
+    const UINT miscFlags = D3D11_RESOURCE_MISC_SHARED
+                         | D3D11_RESOURCE_MISC_SHARED_NTHANDLE
+                         | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX
+                         | D3D11_RESOURCE_MISC_GDI_COMPATIBLE;
+
+    // UAVs add the R32 formats; video and depth are left alone
+    const UINT bindFlags = D3D11_BIND_UNORDERED_ACCESS
+                         | D3D11_BIND_DEPTH_STENCIL
+                         | D3D11_BIND_DECODER
+                         | D3D11_BIND_VIDEO_ENCODER;
+
+    if ((m_desc.MiscFlags & miscFlags) || (m_desc.BindFlags & bindFlags))
+      return false;
+
+    // Families whose members compress differently: RGBA8 (UNORM and sRGB
+    // apart from SNORM and the integer formats) and RGB10A2 (UNORM and UINT)
+    return ImageInfo.format == VK_FORMAT_R8G8B8A8_UNORM
+        || ImageInfo.format == VK_FORMAT_A2B10G10R10_UNORM_PACK32;
+  }
+
+
+  bool D3D11CommonTexture::FamilyHas(
+    const DXGI_VK_FORMAT_FAMILY& Family,
+          VkFormat              Format) {
+    for (uint32_t i = 0; i < Family.FormatCount; i++) {
+      if (Family.Formats[i] == Format)
+        return true;
+    }
+
+    return false;
+  }
+
+
+  void D3D11CommonTexture::MarkUsed() const {
+    std::lock_guard<dxvk::mutex> lock(m_narrowMutex);
+    uint32_t expected = NarrowUnused;
+    m_narrowState.compare_exchange_strong(expected, NarrowUsed, std::memory_order_acq_rel);
+  }
+
+
+  void D3D11CommonTexture::AttachView(
+          D3D11ImageViewOwner*  pView,
+          VkFormat              Format) {
+    std::lock_guard<dxvk::mutex> lock(m_narrowMutex);
+    uint32_t state = m_narrowState.load(std::memory_order_acquire);
+
+    if ((state == NarrowUnused || state == NarrowUsed)
+     && !FamilyHas(m_viewFamily, Format) && FamilyHas(m_fullFamily, Format)) {
+      if (state == NarrowUnused) {
+        WidenLocked(Format);
+      } else if (!m_warnedUsedView) {
+        m_warnedUsedView = true;
+        Logger::warn(str::format("D3D11: ", m_desc.Width, "x", m_desc.Height,
+          " texture with a narrowed format list gets a ", Format,
+          " view after its first use; compressed blocks may read wrong through it",
+          " (set d3d11.narrowTypelessFormats = False for this game)"));
+      }
+    }
+
+    pView->CreateImageView(m_image);
+
+    if (m_narrowState.load(std::memory_order_relaxed) == NarrowUnused)
+      m_views.push_back(pView);
+  }
+
+
+  void D3D11CommonTexture::DetachView(
+          D3D11ImageViewOwner*  pView) {
+    std::lock_guard<dxvk::mutex> lock(m_narrowMutex);
+
+    for (auto i = m_views.begin(); i != m_views.end(); i++) {
+      if (*i == pView) {
+        m_views.erase(i);
+        break;
+      }
+    }
+  }
+
+
+  bool D3D11CommonTexture::WidenLocked(
+          VkFormat              Format) {
+    DxvkImageCreateInfo info = m_imageInfo;
+    info.viewFormatCount = m_fullFamily.FormatCount;
+    info.viewFormats     = m_fullFamily.Formats;
+
+    for (uint32_t i = 0; i < info.viewFormatCount; i++)
+      info.usage |= EnableMetaCopyUsage(info.viewFormats[i], info.tiling);
+
+    if (!CheckImageSupport(&info, info.tiling)) {
+      Logger::warn(str::format("D3D11: Cannot rebuild ", m_desc.Width, "x", m_desc.Height,
+        " texture for a ", Format, " view"));
+      m_narrowState.store(NarrowUsed, std::memory_order_release);
+      return false;
+    }
+
+    // Nothing but its initialization has used the image yet: a new image
+    // takes its place and its contents, and its views move to it
+    Rc<DxvkImage> oldImage = m_image;
+    m_image     = m_device->GetDXVKDevice()->createImage(info, m_memoryProperties);
+    m_imageInfo = info;
+
+    for (auto view : m_views)
+      view->CreateImageView(m_image);
+
+    m_views.clear();
+    m_device->InitRebuiltTexture(this, oldImage);
+    m_narrowState.store(NarrowWidened, std::memory_order_release);
+
+    Logger::info(str::format("D3D11: Rebuilt ", m_desc.Width, "x", m_desc.Height,
+      " texture with its full format list for a ", Format, " view"));
+    return true;
+  }
+
+
   D3D11CommonTexture::~D3D11CommonTexture() {
 
   }
@@ -351,7 +506,19 @@ namespace dxvk {
 
 
   bool D3D11CommonTexture::CheckViewCompatibility(UINT BindFlags, DXGI_FORMAT Format, UINT Plane) const {
-    const DxvkImageCreateInfo& imageInfo = m_image->info();
+    std::unique_lock<dxvk::mutex> narrowLock(m_narrowMutex, std::defer_lock);
+
+    if (m_narrowState.load(std::memory_order_acquire) != NarrowNone)
+      narrowLock.lock();
+
+    DxvkImageCreateInfo imageInfo = m_image->info();
+
+    // A narrowed texture takes views of its whole family: AttachView
+    // rebuilds it, or warns once it is too late to
+    if (m_narrowState.load(std::memory_order_relaxed) != NarrowNone) {
+      imageInfo.viewFormatCount = m_fullFamily.FormatCount;
+      imageInfo.viewFormats     = m_fullFamily.Formats;
+    }
 
     // Check whether the given bind flags are supported
     if ((m_desc.BindFlags & BindFlags) != BindFlags)
